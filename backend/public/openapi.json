{
  "openapi": "3.0.3",
  "info": {
    "title": "UAV scoped integration API",
    "version": "1.0.0",
    "description": "Khóa Bearer do ADMIN cấp cho tài khoản dịch vụ không ADMIN; một lần hiển thị, lưu SHA256, tối đa 365 ngày. Mã externalId có namespace theo user để luân chuyển khóa không đổi mapping. Đây là giao diện tích hợp chung; chưa có adapter/đặc tả PMIS thực."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/open/v1/context": {
      "get": {
        "summary": "Tài khoản và nhà máy được giao",
        "description": "Quyền assets:read; đồng thời kiểm tra đơn vị và nhà máy của tài khoản dịch vụ.",
        "security": [
          {
            "ApiKeyBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công; JSON {code:0,data:...} hoặc tệp báo cáo"
          },
          "400": {
            "description": "Dữ liệu không hợp lệ"
          },
          "401": {
            "description": "Khóa hết hạn/thu hồi/tài khoản không hoạt động"
          },
          "403": {
            "description": "Ngoài phạm vi hoặc thiếu quyền"
          },
          "409": {
            "description": "Revision xung đột; GET lại trước khi sửa"
          },
          "429": {
            "description": "Vượt 120 yêu cầu/phút"
          }
        }
      }
    },
    "/api/open/v1/tasks": {
      "get": {
        "summary": "Danh sách phiếu trong phạm vi",
