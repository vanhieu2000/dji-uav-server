# Local development only. Docker deployment: ops/init-secrets.py + docs/OPERATIONS.md.
HOST_IP=auto
LOCAL_NETWORK_MODE=lan
PORT=8080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=uav
MYSQL_PASSWORD=
MYSQL_DATABASE=dji_uav_management
# Blank JWT_SECRET creates an ignored persistent key file; explicit secret must be >=32 bytes.
JWT_SECRET=

# Factory deployment domains (DNS/certificate required).
# UAV_DOMAIN=uav.example.org
# S3_DOMAIN=storage.example.org
# TRUST_PROXY=1
# CORS_ALLOWED_ORIGINS=https://uav.example.org

# DJI license: obtain from developer.dji.com; never commit actual keys.
DJI_APP_ID=
DJI_APP_KEY=
DJI_APP_LICENSE=
# Telemetry broker credentials are generated per Pilot session, bound to RC/UAV serial.
# MQTT_PUBLIC_URL=ssl://uav.example.org:8883
# RTMP_PUBLIC_BASE_URL=rtmps://uav.example.org:1936
LIVE_STREAM_ENABLED=false
DJI_LIVE_CONTROL_ENABLED=false
ENABLE_MQTT_DEBUG=false
MEDIA_HTTP_BASE_URL=

# Real S3 STS configuration; absent => upload grant returns 503, manual JPEG import remains available.
S3_STS_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_SERVICE_ACCESS_KEY=
S3_SERVICE_SECRET_KEY=
S3_BUCKET=dji-media
S3_REGION=us-east-1
# *_FILE variants supported for MYSQL_PASSWORD, JWT_SECRET, S3 keys, SMTP_PASSWORD, Vision keys.

# Vision contract/service/model are supplied by the Vision team.
VISION_ENABLED=false
VISION_ENDPOINT=
VISION_PUBLIC_BASE_URL=
VISION_API_TOKEN=
VISION_WEBHOOK_SECRET=

# Real email recovery; disabled until configured.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_BASE_URL=
