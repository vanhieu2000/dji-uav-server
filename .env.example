# Sao chep file nay thanh .env roi dien gia tri that
HOST_IP=192.168.1.100
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=change_me_min_8_chars
JWT_SECRET=change_me_long_random_string
# Lay tu https://developer.dji.com (App ID / App Key / App License)
DJI_APP_ID=
DJI_APP_KEY=
DJI_APP_LICENSE=

# Chay local (3_Chay_Server_Local_Ngay.bat): MySQL cai tren may.
# Khi chay Docker, docker-compose tu dat cac bien nay cho backend.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=dji_uav_management
